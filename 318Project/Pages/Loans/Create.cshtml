@page
@model _318Project.Pages.Loans.CreateModel

@{
    ViewData["Title"] = "Check Out Book";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form method="post">
    <div class="mb-3">
        <label asp-for="SelectedBookId" class="form-label">Book</label>
        <select asp-for="SelectedBookId" asp-items="Model.BooksList" class="form-select">
            <option value="0">-- select a book --</option>
        </select>
        <span asp-validation-for="SelectedBookId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedMemberId" class="form-label">Member</label>
        <select asp-for="SelectedMemberId" asp-items="Model.MembersList" class="form-select">
            <option value="0">-- select a member --</option>
        </select>
        <span asp-validation-for="SelectedMemberId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Checked Out</label>
        <input class="form-control" value="@Model.CheckoutDate" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Due On</label>
        <input class="form-control" value="@Model.DueDate" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Check Out</button>
</form>

<partial name="_ValidationScriptsPartial" />
