@page
@model _318Project.Pages.Members.IndexModel

@{
    ViewData["Title"] = "Members";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Join Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Member)
        {
            <tr>
                <td>@member.FullName</td>
                <td>@member.Email</td>
                <td>@member.Phone</td>
                <td>@member.JoinDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@member.MemberId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@member.MemberId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@member.MemberId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
