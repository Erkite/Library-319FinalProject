<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _318Project</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_318Project.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Library</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Members/Index">Members</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Loans/Create">Check Out</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Loans/Return">Return Book</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Loans/Index">Checked Out Books</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Fines/Index">Manage Fines</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Reports/Overdue">Overdue Loans</a></li>
                    </ul>

                    @{
                        // safely pull the current search term from the query string
                        var searchTerm = Context.Request.Query["SearchTitle"].ToString() ?? string.Empty;
                    }
                    <form asp-page="/Books/Index" method="get" class="d-flex" role="search">
                        @{
                            var searchTerm = Context.Request.Query["SearchTitle"].ToString() ?? string.Empty;
                        }
                        <input type="search"
                               name="SearchTitle"
                               class="form-control me-2"
                               placeholder="Search books…"
                               aria-label="Search books"
                               value="@searchTerm" />
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>


                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - _318Project - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
